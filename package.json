{
  "name": "rock-paper-scissors",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @rps/game",
    "dev:server": "npm run dev -w @rps/server",
    "build": "npm run build -w @rps/game",
    "preview": "npm run preview -w @rps/game",
    "test": "vitest run --config config/vitest.config.ts",
    "test:watch": "vitest --config config/vitest.config.ts",
    "test:e2e": "npm run test:e2e -w @rps/game",
    "typecheck": "tsc -p packages/core && tsc -p apps/game && tsc -p apps/server",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audio": "node tools/audio/make-audio.mjs",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "prettier": {
    "singleQuote": true,
    "printWidth": 110
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^6.4.1",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
