// Cloudflare settings for the match server. Deployed by .github/workflows/deploy-server.yml on
// pushes to main (or by hand with `npm run deploy -w @rps/server` after `npx wrangler login`).
{
  "name": "rps-rivals-server",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RoomObject" }],
  },
  // The free plan only offers SQLite-backed Durable Objects, so the class is declared as one
  // (the room keeps everything in memory and never uses the storage).
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomObject"] }],
}
